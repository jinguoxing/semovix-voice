# ============================================================
# Semovix Voice Studio 环境变量示例
# 复制为 .env 后按需修改；服务端与 Python Worker 各读自己那部分。
# ============================================================

# ---------- Node 服务端（server.ts） ----------

# HTTP 端口（默认 3000）。服务只监听 127.0.0.1，不暴露局域网。
# PORT=3000

# Google Gemini API key：云端 TTS（gemini-2.5-*-preview-tts）与云端转录必需。
# 不配置时这些引擎如实返回不可用，不伪造结果。
# GEMINI_API_KEY=

# Python FastAPI Worker 地址（Qwen3-TTS 合成 / Whisper 转录，硬性约束 #14）。
# 启动方式：双击 worker/「启动Worker.command」，或
#   cd worker && python -m uvicorn app:app --host 127.0.0.1 --port 8800
# SEMOVIX_WORKER_URL=http://127.0.0.1:8800

# 素材库根目录（SQLite 库文件、素材音频、生成工件 artifacts/）。
# SEMOVIX_LIBRARY_DIR=/absolute/path/to/library

# 本地 Ollama（可选，转录后摘要/情绪/标签的本地推理；默认端口 11434）。
# OLLAMA_URL=http://127.0.0.1:11434

# ---------- Python FastAPI Worker（worker/app.py） ----------

# Worker 使用的 Python 解释器：二选一（都不设则用 PATH 上的 python3）。
#   SEMOVIX_PYTHON_BIN  直接指定解释器绝对路径（优先级更高）
#   SEMOVIX_CONDA_ENV   conda 环境名（默认 qwen3-tts，经 conda run 调用）
# SEMOVIX_PYTHON_BIN=/absolute/path/to/python
# SEMOVIX_CONDA_ENV=qwen3-tts

# Qwen3-TTS 检查点：默认 HuggingFace repo id（首跑联网下载）；
# 本机已有权重时指向本地目录（模型运行时的官方 speaker 目录以 /voices 为准）。
# SEMOVIX_TTS_CKPT=/path/to/Qwen3-TTS-12Hz-1.7B-CustomVoice

# Whisper ASR 模型 ID（transformers pipeline 格式）。
# SEMOVIX_ASR_MODEL=openai/whisper-large-v3-turbo

# Worker 监听端口（默认 8800；Node 侧需同步 SEMOVIX_WORKER_URL）。
# SEMOVIX_WORKER_PORT=8800

# ---------- Vite（可选） ----------
# DISABLE_HMR=true  # AI Studio 内禁用 HMR/文件监听
